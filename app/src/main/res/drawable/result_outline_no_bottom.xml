<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/banana_border" />
            <corners
                android:topLeftRadius="@dimen/scan_result_corner_radius"
                android:topRightRadius="@dimen/scan_result_corner_radius" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="bottom">
        <shape>
            <solid android:color="@color/banana_surface" />
        </shape>
    </item>
</layer-list>
