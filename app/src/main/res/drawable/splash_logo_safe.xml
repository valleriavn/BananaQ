<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 masks splash icons to an adaptive-icon safe area. Keeping the
    complete BananaQ mark inside this inset prevents the yellow ring and handle
    from being cropped into a rounded square.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="18%"
    android:insetTop="18%"
    android:insetRight="18%"
    android:insetBottom="18%">
    <bitmap
        android:src="@drawable/ic_logo"
        android:gravity="fill"
        android:filter="true" />
</inset>
