<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/banana_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_manual_back" android:contentDescription="@string/back_label" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/account_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:padding="16dp" android:background="@drawable/manual_card" android:src="@drawable/ic_account" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:text="@string/guest_name" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="@string/guest_description" android:textColor="#626B5D" android:textSize="14sp" />
            <TextView style="@style/ManualSection" android:text="@string/account_section" />
            <TextView style="@style/ManualRow" android:text="@string/profile_label" android:enabled="false" android:clickable="false" android:focusable="false" android:alpha="0.5" />
            <TextView android:id="@+id/manualRow" style="@style/ManualRow" android:text="@string/user_manual" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            <TextView style="@style/ManualSection" android:text="@string/settings_section" />
            <TextView style="@style/ManualRow" android:text="@string/notifications_label" android:enabled="false" android:clickable="false" android:focusable="false" android:alpha="0.5" />
            <TextView style="@style/ManualRow" android:text="@string/settings_label" android:enabled="false" android:clickable="false" android:focusable="false" android:alpha="0.5" />
            <TextView style="@style/ManualSection" android:text="@string/legal_section" />
            <TextView android:id="@+id/termsRow" style="@style/ManualRow" android:text="@string/terms_of_use" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            <TextView android:id="@+id/privacyRow" style="@style/ManualRow" android:text="@string/privacy_policy" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            <TextView android:id="@+id/agreementRow" style="@style/ManualRow" android:text="@string/user_agreement" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>