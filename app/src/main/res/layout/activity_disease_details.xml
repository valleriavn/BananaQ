<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/banana_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/banana_green"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/detailLanguage"
            android:layout_width="88dp"
            android:layout_height="32dp"
            android:background="@drawable/library_language_pill"
            android:gravity="center"
            android:textColor="@color/banana_green"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@color/banana_border" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back_label"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back_green" />
                <TextView
                    android:id="@+id/detailDiseaseName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:textColor="@color/banana_text_dark"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detailDiseaseImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/LibraryImageShape" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/banana_yellow_light"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/disease_scientific_name"
                        android:textColor="@color/banana_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/detailScientificName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/banana_body"
                        android:textSize="15sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DiseaseDetailSectionCard"
                android:layout_marginTop="14dp">
                <LinearLayout style="@style/DiseaseDetailSectionContent">
                    <TextView style="@style/DiseaseDetailSectionTitle" android:text="@string/disease_description_heading" />
                    <TextView android:id="@+id/detailDescription" style="@style/DiseaseDetailSectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DiseaseDetailSectionCard"
                android:layout_marginTop="12dp">
                <LinearLayout style="@style/DiseaseDetailSectionContent">
                    <TextView style="@style/DiseaseDetailSectionTitle" android:text="@string/disease_symptoms" />
                    <TextView android:id="@+id/detailSymptoms" style="@style/DiseaseDetailSectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DiseaseDetailSectionCard"
                android:layout_marginTop="12dp">
                <LinearLayout style="@style/DiseaseDetailSectionContent">
                    <TextView style="@style/DiseaseDetailSectionTitle" android:text="@string/disease_spread" />
                    <TextView android:id="@+id/detailSpread" style="@style/DiseaseDetailSectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/disease_note_background"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:text="@string/disease_guidance_note"
                android:textColor="@color/banana_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
