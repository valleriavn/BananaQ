<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:background="@color/banana_cream">

<LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/header_horizontal_padding" android:paddingEnd="@dimen/header_horizontal_padding" android:paddingTop="@dimen/app_header_vertical_spacing" app:layout_constraintTop_toTopOf="parent" android:orientation="vertical">
    <bananaq.ResponsiveHeaderRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/app_header_vertical_spacing">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginEnd="@dimen/spacing_8" android:layout_weight="1">
            <ImageView android:id="@+id/headerLogo" android:layout_width="@dimen/app_header_logo_size" android:layout_height="@dimen/app_header_logo_size" android:src="@drawable/logo" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_8" android:text="@string/app_name" android:textColor="@color/banana_green" android:textSize="@dimen/app_header_brand_text_size" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/feedbackHeaderLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/header_language_badge" android:gravity="center" android:text="@string/language_current" android:textColor="@color/banana_green" android:textSize="@dimen/app_header_language_text_size" android:minWidth="88dp" android:paddingStart="@dimen/spacing_12" android:paddingEnd="@dimen/spacing_12" />
    </bananaq.ResponsiveHeaderRow>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/banana_divider" app:layout_constraintBottom_toBottomOf="parent" />
</LinearLayout>

    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center_vertical" android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_padding" android:paddingEnd="@dimen/page_horizontal_padding"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="@dimen/page_content_max_width">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_label"
            android:src="@drawable/ic_arrow_back_green"
            app:tint="@color/banana_green" android:padding="@dimen/spacing_12" android:scaleType="fitCenter" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="@string/feedback_title"
            android:textColor="@color/banana_text_dark"
            android:textSize="@dimen/page_heading_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="@dimen/page_content_max_width">
        <bananaq.ContentColumn android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/page_heading_gap"
            android:paddingStart="@dimen/page_horizontal_padding" android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/spacing_24">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/banana_surface"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_content_padding">
                    <bananaq.ResponsiveFeedbackHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:baselineAligned="false"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/ivScanDetail"
                            android:layout_width="142dp"
                            android:layout_height="88dp"
                            android:background="@drawable/rounded_button_bg"
                            android:contentDescription="@string/scanned_banana_leaf"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo" />
                        <LinearLayout
                            android:id="@+id/resultMetaLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:layout_weight="1"
                            android:gravity="center_vertical" android:baselineAligned="false"
                            android:minHeight="88dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDateTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/banana_muted"
                                android:textSize="9sp"
                                tools:text="Today at 04:15 PM" />
                            <TextView
                                android:id="@+id/tvDiseaseName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:textColor="@color/banana_body"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Black Sigatoka" />
                            <TextView
                                android:id="@+id/tvConfidenceLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/confidence_score_label"
                                android:textColor="@color/banana_muted"
                                android:textSize="9sp" />
                            <TextView
                                android:id="@+id/tvAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#F25C5C"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="91.1%" />
                        </LinearLayout>
                    </bananaq.ResponsiveFeedbackHeader>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginBottom="@dimen/spacing_12"
                        android:background="@color/banana_yellow" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_question"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp"
                        android:textStyle="bold|italic" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_instruction"
                        android:textColor="@color/banana_muted"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/ratingGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|center_horizontal"
                            android:orientation="horizontal">

                            <LinearLayout android:id="@+id/rateVeryAccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_very_accurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_very_accurate" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/rateAccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_accurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_accurate" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|center_horizontal"
                            android:orientation="horizontal">

                            <LinearLayout android:id="@+id/rateNotSure" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_not_sure" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_not_sure" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/rateInaccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_inaccurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_inaccurate" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/rateVeryInaccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_very_inaccurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_very_inaccurate" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/additional_comments"
                        android:textColor="@color/banana_muted"
                        android:textSize="10sp" />
                    <EditText
                        android:id="@+id/etComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="64dp"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:background="@drawable/feedback_comment_bg"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:imeOptions="flagNoExtractUi"
                        android:hint="@string/comments_hint"
                        android:padding="@dimen/spacing_12"
                        android:textColor="@color/banana_body"
                        android:textColorHint="@color/banana_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_24"
                android:minWidth="170dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/submit_feedback"
                android:textAllCaps="false"
                android:textColor="@color/agreement_button_text_selector"
                android:textSize="14sp"
                android:textStyle="normal"
                app:backgroundTint="@color/agreement_button_default_selector"
                app:cornerRadius="@dimen/pill_corner_radius"
                app:strokeWidth="0dp" />
        </bananaq.ContentColumn>
    </ScrollView>

    <ScrollView
        android:id="@+id/successScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="@dimen/page_content_max_width">
        <bananaq.ContentColumn android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding" android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_heading_gap"
            android:paddingBottom="@dimen/spacing_24">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/banana_surface"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_24"
                    android:paddingBottom="@dimen/spacing_24">
                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content" android:minHeight="64dp"
                        android:background="@drawable/feedback_success_circle"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:gravity="center"
                        android:text="@string/feedback_thank_you"
                        android:textColor="@color/banana_body"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/feedback_thank_you_message"
                        android:textColor="@color/banana_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                app:cardBackgroundColor="@color/banana_surface"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_16"
                    android:paddingBottom="@dimen/spacing_16">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:text="@string/response_summary"
                        android:textColor="@color/banana_text_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_scan" />
                        <TextView android:id="@+id/summaryScan" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>
                    <LinearLayout style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_accuracy" />
                        <TextView android:id="@+id/summaryRating" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/summaryConfidenceRow"
                        style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_confidence" />
                        <TextView android:id="@+id/summaryConfidence" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>
                    <LinearLayout style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_submitted" />
                        <TextView android:id="@+id/summarySubmitted" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/summaryComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@drawable/feedback_comment_bg"
                        android:minHeight="58dp"
                        android:gravity="top|start"
                        android:padding="@dimen/spacing_12"
                        android:textColor="@color/banana_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_24"
                android:minWidth="130dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/return_label"
                android:textAllCaps="false"
                android:textColor="@color/agreement_button_text_selector"
                android:textStyle="normal"
                app:backgroundTint="@color/agreement_button_default_selector"
                app:cornerRadius="@dimen/pill_corner_radius"
                app:strokeWidth="0dp" />
        </bananaq.ContentColumn>
    </ScrollView>

    <bananaq.RaisedBottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_navigation_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
