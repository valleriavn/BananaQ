<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:background="@color/banana_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="56dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/headerLogo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        <TextView
            android:layout_width="0dp"
            app:layout_constraintEnd_toStartOf="@id/feedbackHeaderLanguage"
            android:layout_marginEnd="8dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="@color/banana_green"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/headerLogo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        <TextView
            android:id="@+id/feedbackHeaderLanguage"
            android:layout_width="88dp"
            android:layout_height="wrap_content" android:minHeight="32dp"
            android:gravity="center"
            android:background="@drawable/rounded_button_bg"
            android:backgroundTint="@color/banana_surface"
            android:text="@string/language_current"
            android:textColor="@color/banana_green"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/banana_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="56dp"
        android:gravity="center_vertical" android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_horizontal_padding"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_label"
            android:src="@drawable/ic_arrow_back_green"
            app:tint="@color/banana_green" android:padding="12dp" android:scaleType="fitCenter" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/feedback_title"
            android:textColor="@color/banana_text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/banana_surface"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:baselineAligned="false"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/ivScanDetail"
                            android:layout_width="142dp"
                            android:layout_height="88dp"
                            android:background="@drawable/rounded_button_bg"
                            android:contentDescription="@string/scanned_banana_leaf"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_logo" />
                        <LinearLayout
                            android:id="@+id/resultMetaLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical" android:baselineAligned="false"
                            android:minHeight="88dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDateTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/banana_muted"
                                android:textSize="9sp"
                                tools:text="Today at 04:15 PM" />
                            <TextView
                                android:id="@+id/tvDiseaseName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/banana_body"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Black Sigatoka" />
                            <TextView
                                android:id="@+id/tvConfidenceLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/confidence_score_label"
                                android:textColor="@color/banana_muted"
                                android:textSize="9sp" />
                            <TextView
                                android:id="@+id/tvAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#F25C5C"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="91.1%" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/banana_yellow" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_question"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp"
                        android:textStyle="bold|italic" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_instruction"
                        android:textColor="@color/banana_muted"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/ratingGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout android:id="@+id/rateVeryAccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_very_accurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_very_accurate" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/rateAccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_accurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_accurate" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout android:id="@+id/rateNotSure" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_not_sure" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_not_sure" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/rateInaccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_inaccurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_inaccurate" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/rateVeryInaccurate" style="@style/FeedbackRatingOption">
                                <ImageView style="@style/FeedbackRatingIcon" android:src="@drawable/ic_rating_very_inaccurate" android:contentDescription="@null" />
                                <TextView style="@style/FeedbackRatingLabel" android:text="@string/rating_very_inaccurate" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/additional_comments"
                        android:textColor="@color/banana_muted"
                        android:textSize="10sp" />
                    <EditText
                        android:id="@+id/etComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="64dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/feedback_comment_bg"
                        android:gravity="top|start"
                        android:hint="@string/comments_hint"
                        android:padding="10dp"
                        android:textColor="@color/banana_body"
                        android:textColorHint="@color/banana_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:minWidth="170dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/submit_feedback"
                android:textAllCaps="false"
                android:textColor="@color/agreement_button_text_selector"
                android:textSize="14sp"
                android:textStyle="normal"
                app:backgroundTint="@color/agreement_button_default_selector"
                app:cornerRadius="@dimen/pill_corner_radius"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/successScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/banana_surface"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="22dp">
                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content" android:minHeight="64dp"
                        android:background="@drawable/feedback_success_circle"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/feedback_thank_you"
                        android:textColor="@color/banana_body"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/feedback_thank_you_message"
                        android:textColor="@color/banana_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/banana_surface"
                app:cardCornerRadius="@dimen/container_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/banana_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/response_summary"
                        android:textColor="@color/banana_text_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_scan" />
                        <TextView android:id="@+id/summaryScan" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>
                    <LinearLayout style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_accuracy" />
                        <TextView android:id="@+id/summaryRating" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/summaryConfidenceRow"
                        style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_confidence" />
                        <TextView android:id="@+id/summaryConfidence" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>
                    <LinearLayout style="@style/FeedbackSummaryRow">
                        <TextView style="@style/FeedbackSummaryLabel" android:text="@string/summary_submitted" />
                        <TextView android:id="@+id/summarySubmitted" style="@style/FeedbackSummaryValue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/summaryComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/feedback_comment_bg"
                        android:minHeight="58dp"
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:textColor="@color/banana_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:minWidth="130dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/return_label"
                android:textAllCaps="false"
                android:textColor="@color/agreement_button_text_selector"
                android:textStyle="normal"
                app:backgroundTint="@color/agreement_button_default_selector"
                app:cornerRadius="@dimen/pill_corner_radius"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </ScrollView>

    <com.example.bananaq.RaisedBottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_navigation_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
