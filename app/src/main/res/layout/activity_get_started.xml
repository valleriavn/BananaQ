<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/onboarding_yellow">
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/onboarding_yellow">

    <View
        android:id="@+id/pageBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/onboarding_cream"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/curveBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGetStarted" />

    <View
        android:id="@+id/topCurve"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/get_started_curve"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/curveBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/logoOnboarding"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/get_started_logo_top_margin"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/descText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal_padding"
        android:layout_marginEnd="@dimen/page_horizontal_padding"
        android:layout_marginTop="@dimen/spacing_32"
        android:gravity="center"
        android:text="@string/get_started_message"
        android:textColor="@color/button_text_black"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoOnboarding" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetStarted"
        app:layout_constrainedWidth="true"
        android:layout_marginStart="@dimen/page_horizontal_padding" android:layout_marginEnd="@dimen/page_horizontal_padding"
        android:layout_width="wrap_content" android:minWidth="160dp"
        android:layout_height="wrap_content" android:minHeight="50dp"
        android:layout_marginTop="@dimen/spacing_40"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/get_started_button"
        android:textAllCaps="false"
        android:textColor="@color/agreement_button_text_selector"
        android:textSize="16sp"
        android:textStyle="normal"
        app:backgroundTint="@color/agreement_button_default_selector"
        app:cornerRadius="@dimen/pill_corner_radius"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/descText" />

    <ImageView
        android:id="@+id/bananaPlant"
        android:layout_width="0dp"
        android:layout_height="@dimen/onboarding_farmer_height"
        android:layout_marginStart="@dimen/page_horizontal_padding" android:layout_marginEnd="@dimen/page_horizontal_padding"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_max="420dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/img_farmer_checking_leaf"
        app:layout_constraintTop_toBottomOf="@id/curveBottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
