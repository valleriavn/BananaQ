<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_cream"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="480dp">

    <ImageView
        android:id="@+id/logoSmall"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="@dimen/onboarding_logo_top_margin"
        android:src="@drawable/ic_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/banana_green"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoSmall" />

    <LinearLayout
        android:id="@+id/languageIntroBlock"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText">

        <TextView
            android:id="@+id/subTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/language_welcome"
            android:textColor="@color/banana_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/language_instruction"
            android:textColor="@color/banana_text_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnEnglish"
        android:layout_width="0dp"
        app:layout_constraintWidth_max="@dimen/language_choice_width"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/btn_language_green"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/languageIntroBlock">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/flag_us_circle" />

        <TextView
            android:id="@+id/labelEnglish"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationX="6dp"
            android:text="@string/language_english"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnTagalog"
        android:layout_width="0dp"
        app:layout_constraintWidth_max="@dimen/language_choice_width"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_language_yellow"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEnglish">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/flag_ph_circle" />

        <TextView
            android:id="@+id/labelTagalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationX="6dp"
            android:text="@string/language_tagalog"
            android:textColor="@color/button_text_black"
            android:textSize="18sp" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnTagalog"
        app:layout_constraintVertical_bias="1"
        android:layout_width="wrap_content" android:minWidth="150dp"
        android:layout_height="wrap_content" android:minHeight="50dp"
        android:layout_marginBottom="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/continue_label"
        android:textAllCaps="false"
        android:textColor="@color/agreement_button_text_selector"
        android:textSize="15sp"
        android:textStyle="normal"
        app:backgroundTint="@color/agreement_button_default_selector"
        app:cornerRadius="@dimen/pill_corner_radius"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
