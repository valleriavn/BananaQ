<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/banana_cream">

<LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/header_horizontal_padding" android:paddingEnd="@dimen/header_horizontal_padding" android:paddingTop="@dimen/home_header_vertical_spacing" app:layout_constraintTop_toTopOf="parent" android:orientation="vertical">
    <com.example.bananaq.ResponsiveHeaderRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/home_header_vertical_spacing">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginEnd="@dimen/spacing_8" android:layout_weight="1">
            <ImageView android:id="@+id/logoIcon" android:layout_width="@dimen/app_header_logo_size" android:layout_height="@dimen/app_header_logo_size" android:src="@drawable/logo" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_8" android:text="@string/app_name" android:textColor="@color/banana_green" android:textSize="@dimen/app_header_brand_text_size" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/headerLanguageToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:background="@drawable/header_language_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="0dp" android:minWidth="88dp">
            <TextView android:id="@+id/tvLangEN" android:layout_width="wrap_content" android:minWidth="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="@dimen/spacing_8" android:paddingEnd="@dimen/spacing_8" android:layout_weight="1" android:background="@drawable/header_language_selected" android:gravity="center" android:text="@string/language_code_english" android:textColor="@color/white" android:textSize="@dimen/app_header_language_text_size" android:textStyle="bold" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvLangTL" android:layout_width="wrap_content" android:minWidth="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="@dimen/spacing_8" android:paddingEnd="@dimen/spacing_8" android:layout_weight="1" android:gravity="center" android:text="@string/language_code_tagalog" android:textColor="@color/button_text_black" android:textSize="@dimen/app_header_language_text_size" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </com.example.bananaq.ResponsiveHeaderRow>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/banana_divider" app:layout_constraintBottom_toBottomOf="parent" />
</LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/largeTextHomeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation" app:layout_constraintWidth_max="@dimen/page_content_max_width">
    <com.example.bananaq.ContentColumn android:layout_gravity="center_horizontal"
        android:id="@+id/homeContent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="@dimen/spacing_8"
>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_horizontal_padding" android:layout_marginEnd="@dimen/page_horizontal_padding" android:text="@string/home_greeting"
            android:textSize="@dimen/page_heading_text_size" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
        <ImageView android:id="@+id/ivSoil" android:layout_width="match_parent"
            android:layout_height="@dimen/home_illustration_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/page_horizontal_padding" android:layout_marginEnd="@dimen/page_horizontal_padding"
            android:scaleType="fitCenter" android:src="@drawable/img_farmer_checking_leaf"
            android:importantForAccessibility="no" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_horizontal_padding" android:layout_marginEnd="@dimen/page_horizontal_padding" android:layout_marginTop="@dimen/spacing_8" android:layout_marginBottom="0dp"
            app:cardBackgroundColor="@color/banana_surface" app:cardCornerRadius="@dimen/container_corner_radius"
            app:cardElevation="2dp" app:strokeColor="@color/banana_border" app:strokeWidth="1dp">
            <com.example.bananaq.ResponsiveDateTimeRow android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/homeDateTimeRow" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/compact_card_padding">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/dateText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/banana_text_dark"
                        android:textSize="14sp" />
                    <TextView android:id="@+id/dayMonthText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/banana_text_dark"
                        android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/timeText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_8"
                    android:textColor="@color/banana_text_dark" android:textSize="18sp" android:textStyle="bold" />
            </com.example.bananaq.ResponsiveDateTimeRow>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_horizontal_padding" android:layout_marginEnd="@dimen/page_horizontal_padding" android:layout_marginTop="@dimen/section_gap"
            android:layout_marginBottom="@dimen/spacing_8" android:text="@string/disease_library_title"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/diseaseCarousel" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:layout_marginBottom="@dimen/spacing_24" android:clipToPadding="true"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" android:scrollbars="none"
            android:contentDescription="@string/disease_library_title" />
    </com.example.bananaq.ContentColumn>

    </androidx.core.widget.NestedScrollView>

    <com.example.bananaq.RaisedBottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_navigation_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
