<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/banana_cream">
    <include layout="@layout/include_account_brand_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="16dp" android:paddingHorizontal="@dimen/page_horizontal_padding">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back_green" android:contentDescription="@string/back_label" android:scaleType="fitCenter" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/user_manual" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/page_horizontal_padding" android:paddingTop="12dp" android:paddingBottom="32dp">
            <TextView android:id="@+id/topicTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
            <TextView android:id="@+id/topicBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:paddingStart="22dp" android:background="@drawable/account_information_card" android:textSize="15sp" android:lineSpacingExtra="3dp" android:textColor="@color/banana_body" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
