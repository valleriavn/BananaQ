<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/banana_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_manual_back" android:contentDescription="@string/back_label" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/user_manual" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/library_language_pill" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="@string/language_current" android:textColor="@color/banana_green" android:textSize="11sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/topicTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
            <TextView android:id="@+id/topicBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/manual_card" android:textSize="17sp" android:lineSpacingExtra="5dp" android:textColor="@color/banana_muted" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
