<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/resultPanelTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.30" />

    <ImageView
        android:id="@+id/scannedPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:background="@color/banana_cream"
        android:contentDescription="@string/scanned_photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/cameraScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/topCameraScrim"
        android:layout_width="0dp"
        android:layout_height="132dp"
        android:background="@drawable/scanner_top_scrim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomCameraScrim"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/scanner_bottom_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/scannerHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minHeight="40dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="@drawable/scanner_header_bg"
        android:gravity="center"
        android:minWidth="164dp"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:text="@string/scanner_header"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"  app:layout_constrainedWidth="true" android:layout_marginStart="@dimen/scanner_title_clearance" android:layout_marginEnd="@dimen/scanner_title_clearance"/>

    <TextView
        android:id="@+id/scanResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minHeight="40dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="@drawable/scan_result_title_bg"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:text="@string/scan_result"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"  app:layout_constrainedWidth="true" android:layout_marginStart="@dimen/scanner_title_clearance" android:layout_marginEnd="@dimen/scanner_title_clearance"/>

    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scanner_frame"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_max="340dp"
        android:layout_marginStart="@dimen/spacing_32" android:layout_marginEnd="@dimen/spacing_32"
        app:layout_constraintBottom_toTopOf="@id/instructionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scannerHeader"
        app:layout_constraintVertical_bias="0.43">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_24"
            android:layout_marginEnd="@dimen/spacing_24"
            android:background="@drawable/scanner_guide_line" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/instructionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_12"
        android:background="@drawable/scanner_instruction_bg"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_12"
        app:layout_constraintWidth_max="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsLayout">
        <!-- Reserve the larger status at native text size, so inference cannot move the frame. -->
        <TextView style="@style/ScannerInstructionText" android:text="@string/scan_instruction"
            android:visibility="invisible" android:importantForAccessibility="no" />
        <TextView style="@style/ScannerInstructionText" android:text="@string/processing_photo"
            android:visibility="invisible" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tvInstruction" style="@style/ScannerInstructionText"
            android:layout_gravity="center" android:text="@string/scan_instruction" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="@dimen/spacing_12"
        android:contentDescription="@string/back_label"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="@drawable/scan_result_back_bg"
        android:src="@drawable/ic_arrow_back_green"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_12"
        android:background="@drawable/scanner_control_dock"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnGallery"
            android:contentDescription="@string/choose_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/scanner_action_button_bg"
            android:padding="@dimen/spacing_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_scan_gallery"
            app:tint="@color/white" />

        <View
            android:id="@+id/captureCircle"
            android:contentDescription="@string/capture_photo"
            android:importantForAccessibility="yes"
            android:focusable="true"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            android:background="@drawable/scanner_capture_button" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:contentDescription="@string/flash_on"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/scanner_action_button_bg"
            android:padding="@dimen/spacing_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_scan_flash"
            app:tint="@color/white" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/resultCoordinator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/resultPanelTop">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fullResultCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/result_outline_no_bottom"
            app:cardBackgroundColor="@color/banana_surface"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.BananaQ.ScanResult"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_peekHeight="180dp"
            app:behavior_hideable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_8">
                <FrameLayout
                    android:id="@+id/resultDragHandle"
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="0dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/collapse_scan_result"
                    android:focusable="true">

                    <View
                        android:layout_width="50dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center"
                        android:background="@drawable/result_drag_handle" />
                </FrameLayout>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/largeTextResultScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_horizontal_padding"
                android:paddingEnd="@dimen/page_horizontal_padding"
>



                <bananaq.ResponsiveHeaderRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_12"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/resultDiseaseName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/banana_text_dark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Panama Disease" />
                        <TextView
                            android:id="@+id/resultScientificName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:textColor="@color/banana_muted"
                            android:textSize="11sp"
                            tools:text="Fusarium oxysporum f. sp. cubense" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/accuracyLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/resultAccuracyValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E57373"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="92%" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/confidence_label"
                            android:textColor="@color/banana_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </bananaq.ResponsiveHeaderRow>

                <ProgressBar
                    android:id="@+id/resultAccuracyProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:progressTint="#71C35E"
                    tools:progress="92" />

                <LinearLayout
                    android:id="@+id/extraDetailsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <bananaq.ResponsiveTabRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:scrollbars="horizontal"
                        android:overScrollMode="ifContentScrolls">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabSymptoms" android:minHeight="48dp"
                            android:singleLine="true"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/btn_language_yellow"
                            android:gravity="center"
                            android:paddingTop="@dimen/spacing_8" android:paddingBottom="@dimen/spacing_8"
                            android:text="@string/disease_symptoms"
                            android:textSize="13sp"
                            android:textColor="@color/button_text_black"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tabTreatment" android:minHeight="48dp"
                            android:singleLine="true"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/spacing_8" android:layout_marginRight="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:background="@drawable/btn_language_yellow"
                            android:gravity="center"
                            android:paddingTop="@dimen/spacing_8" android:paddingBottom="@dimen/spacing_8"
                            android:text="@string/treatment_label"
                            android:textSize="13sp"
                            android:textColor="@color/button_text_black" />

                        <TextView
                            android:id="@+id/tabPrevention" android:minHeight="48dp"
                            android:singleLine="true"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/btn_language_yellow"
                            android:gravity="center"
                            android:paddingTop="@dimen/spacing_8" android:paddingBottom="@dimen/spacing_8"
                            android:text="@string/disease_prevention"
                            android:textSize="13sp"
                            android:textColor="@color/button_text_black" />

                        </LinearLayout>
                    </bananaq.ResponsiveTabRow>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/resultSectionTitle"
                                android:layout_marginTop="@dimen/spacing_12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                        android:textColor="@color/banana_body"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Visual Characteristics" />

                            <LinearLayout
                                android:id="@+id/resultContentContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:paddingBottom="@dimen/spacing_16"
                                android:orientation="vertical">
                            </LinearLayout>
                        </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/compactResultPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/result_summary_bg"
        android:minHeight="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_4"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_12"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/compactResultDragHandle"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/expand_scan_result"
            android:focusable="true">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/result_drag_handle" />
        </FrameLayout>

        <TextView
            android:id="@+id/predictionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:textColor="@color/banana_text_dark"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTryAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/try_again"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/banana_green"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
