<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/banana_cream"
    tools:context=".UserAgreement">

    <!-- Fixed Branding Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="25dp"
        android:paddingTop="20dp"
        android:background="@color/banana_cream"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="BananaQ"
                android:textColor="@color/banana_green"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_button_bg"
            android:backgroundTint="#F2EBDC"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/language_english"
            android:textColor="@color/banana_text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/banana_divider"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/agreementScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideOverlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Back Button (Scrollable) -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:contentDescription="@string/back_label"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back_green" />

            <!-- 1. User Agreement Title -->
            <TextView
                android:id="@+id/titleUserAgreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:text="User Agreement"
                android:textColor="@color/banana_text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- User Agreement Card -->
            <LinearLayout
                android:id="@+id/userAgreementContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="30dp"
                android:background="@drawable/bg_agreement_card"
                android:orientation="horizontal"
                android:clipToOutline="true">

                <View
                    android:layout_width="15dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_agreement_yellow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Effective Date: June 2026"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Welcome to BananaQ. By downloading, installing, accessing, or using the BananaQ mobile application (&quot;App&quot;), you agree to comply with and be bound by this User Agreement."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="If you do not agree with any part of this Agreement, you should not use the application."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <!-- Section 1 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="1. Purpose of the Application"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="BananaQ is an educational and agricultural support application designed to help users identify and classify banana leaf diseases through image analysis using a Convolutional Neural Network (CNN).\n\nThe application currently supports the detection of:\n•  Black Sigatoka\n•  Panama Disease\n•  Cordana Leaf Spot"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="2. Eligibility"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="You may use BananaQ if you:\n•  Are at least eighteen (18) years old, or\n•  Have the permission and supervision of a parent, guardian, or authorized organization."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="3. User Responsibilities"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="By using BananaQ, you agree to:\n•  Provide accurate and lawful information when required.\n•  Upload only images that you own or have permission to use.\n•  Use the application only for legal and legitimate agricultural purposes.\n•  Avoid uploading harmful, illegal, offensive, or malicious content."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="4. Accuracy of Results"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="BananaQ uses Artificial Intelligence and machine learning technologies to generate predictions.\n\nUsers acknowledge that:\n•  Detection results are estimates based on image analysis.\n•  Results should not replace professional agricultural consultation.\n•  The developers are not responsible for crop losses, financial losses, or damages resulting from reliance solely on the application's predictions."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="5. Availability of Service"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The developers may update, improve, suspend, or discontinue parts of the application without prior notice for maintenance, research, or development purposes."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="6. Termination"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The developers reserve the right to restrict or terminate access to users who:\n•  Violate this Agreement,\n•  Misuse the application,\n•  Attempt unauthorized access to the system, or\n•  Interfere with the application's operation."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Terms of Use Title -->
            <TextView
                android:id="@+id/titleTermsOfUse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Terms of Use"
                android:textColor="@color/banana_text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Terms of Use Card -->
            <LinearLayout
                android:id="@+id/termsOfUseContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="30dp"
                android:background="@drawable/bg_agreement_card"
                android:orientation="horizontal"
                android:clipToOutline="true">

                <View
                    android:layout_width="15dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_agreement_yellow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Acceptance of Terms"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="By using BananaQ, you agree to these Terms of Use and any future updates."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="2. Permitted Use"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="You may use BananaQ for:\n•  Banana leaf disease identification,\n•  Agricultural learning,\n•  Crop monitoring assistance,\n•  Academic and research purposes."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="3. Prohibited Activities"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Users shall not:\n•  Reverse engineer or attempt to extract the application's source code.\n•  Modify or distribute the application without permission.\n•  Upload viruses, malware, or harmful files.\n•  Use the application for fraudulent or illegal activities.\n•  Attempt to manipulate or exploit the AI prediction system."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="4. Intellectual Property"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="All rights, including but not limited to:\n•  Software,\n•  Source code,\n•  User interface,\n•  AI models,\n•  Graphics,\n•  Documentation,\n•  Logos, and\n•  Other content,\nremain the intellectual property of the BananaQ research and development team unless otherwise stated.\n\nUsers may not reproduce or redistribute these materials without written permission."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="5. Third-Party Technologies"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="BananaQ may use third-party frameworks, libraries, or machine learning models. Such technologies remain subject to their respective licenses."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="6. Disclaimer"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The application is provided on an &quot;as is&quot; and &quot;as available&quot; basis.\n\nThe developers make no guarantees regarding:\n•  Continuous availability,\n•  Absolute accuracy,\n•  Error-free operation,\n•  Suitability for every farming condition."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="7. Limitation of Liability"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="To the maximum extent permitted by law, the developers shall not be liable for:\n•  Crop damage,\n•  Financial losses,\n•  Business interruption,\n•  Data loss,\n•  Indirect or consequential damages,\narising from the use or inability to use BananaQ."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="8. Changes to the Terms"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The developers may revise these Terms of Use from time to time. Continued use of the application constitutes acceptance of the updated terms."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Privacy Policy Title -->
            <TextView
                android:id="@+id/titlePrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Privacy Policy"
                android:textColor="@color/banana_text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Privacy Policy Card -->
            <LinearLayout
                android:id="@+id/privacyPolicyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="30dp"
                android:background="@drawable/bg_agreement_card"
                android:orientation="horizontal"
                android:clipToOutline="true">

                <View
                    android:layout_width="15dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_agreement_yellow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Effective Date: June 2026"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="BananaQ respects the privacy of its users and is committed to protecting personal information."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="1. Information We Collect"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The application may collect the following information:\n\na. User Information\n•  Name\n•  Email address\n•  User feedback and survey responses\n\nb. Uploaded Images\n•  Banana leaf images submitted for disease analysis.\n\nc. Device Information\n•  Android version\n•  Device model\n•  Application version\n•  Diagnostic logs necessary for troubleshooting\n\nd. Usage Data\n•  Frequency of application use\n•  Disease detection history\n•  Feature usage statistics"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="2. How We Use the Information"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Collected information may be used to:\n•  Analyze banana leaf images,\n•  Improve AI model performance,\n•  Enhance application functionality,\n•  Generate anonymous research statistics,\n•  Provide treatment and prevention recommendations,\n•  Resolve technical issues."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="3. Data Storage and Security"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Reasonable technical and administrative safeguards are implemented to protect user information from unauthorized access, disclosure, or misuse.\n\nHowever, no electronic storage system or internet transmission is completely secure, and absolute security cannot be guaranteed."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="4. Data Sharing"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="BananaQ does not sell or rent personal information.\n\nInformation may only be shared:\n•  When required by law,\n•  For approved academic or research purposes in anonymized form,\n•  With authorized service providers assisting in system operation."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="5. Research Use"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="As BananaQ is developed as part of an academic capstone project, anonymized and aggregated data may be used for:\n•  System evaluation,\n•  Performance analysis,\n•  Academic publications,\n•  Future research and development.\n\nNo personally identifiable information will be disclosed without user consent unless required by law."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="6. Data Retention"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="User data will be retained only for as long as necessary to:\n•  Provide application services,\n•  Improve the AI model,\n•  Meet research and legal requirements.\n\nAfterward, data may be securely deleted or anonymized."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="7. User Rights"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Users may request to:\n•  Access their personal information,\n•  Correct inaccurate information,\n•  Request deletion of their data,\n•  Withdraw consent for future data processing, subject to applicable laws and research requirements."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="8. Children's Privacy"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="BananaQ is not intended to knowingly collect personal information from children under thirteen (13) years of age without appropriate parental or guardian consent."
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="9. Consent"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="By using BananaQ, you confirm that:\n•  You understand these policies\n•  You agree to the collection and use of information described above\n•  You will use the application responsibly and lawfully"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="10. Contact"
                        android:textColor="@color/banana_body"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="For privacy concerns, account concerns, or policy questions, users may contact the BananaQ development team through the official support channels inside the application.\n\nEmail: bananaq@gmail.com"
                        android:textColor="@color/banana_body"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Confirmation Section -->
            <LinearLayout
                android:id="@+id/agreementConfirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbConfirmation"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:button="@drawable/checkbox_selector"
                    app:buttonTint="@null"
                    android:buttonTint="@null" />

                <TextView
                    android:id="@+id/tvConfirmationText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="I have read and understood the User Agreement, Terms of Use, and Privacy Policy provided above."
                    android:textColor="@color/banana_text_dark"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/agreementActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="30dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDecline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_language_yellow"
                    android:backgroundTint="@color/banana_divider"
                    android:text="Decline"
                    android:textAllCaps="false"
                    android:textColor="@color/banana_body"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_language_yellow"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@color/banana_text_dark"
                    android:textStyle="bold"
                    android:enabled="false"
                    android:alpha="0.5" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
