<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/banana_cream">
    <include layout="@layout/include_account_brand_header" />
    <bananaq.ContentColumn android:layout_gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="@dimen/spacing_16" android:paddingStart="@dimen/page_horizontal_padding" android:paddingEnd="@dimen/page_horizontal_padding">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="@dimen/spacing_12" android:src="@drawable/ic_arrow_back_green" android:contentDescription="@string/back_label" android:scaleType="fitCenter" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_8" android:text="@string/user_manual" android:textSize="@dimen/page_heading_text_size" android:textStyle="bold" android:textColor="@color/banana_text_dark" />
    </bananaq.ContentColumn>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <bananaq.ContentColumn android:layout_gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_horizontal_padding" android:paddingEnd="@dimen/page_horizontal_padding" android:paddingTop="@dimen/spacing_12" android:paddingBottom="@dimen/content_bottom_padding">
            <TextView style="@style/ManualTopicSection" android:layout_marginTop="@dimen/spacing_4" android:text="@string/manual_getting_started" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/manual_card" android:clipToOutline="true">
                <TextView android:id="@+id/howToRow" style="@style/ManualTopicRow" android:text="@string/manual_how_to" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            </LinearLayout>
            <TextView style="@style/ManualTopicSection" android:text="@string/manual_scanning" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/manual_card" android:clipToOutline="true">
                <TextView android:id="@+id/scanLeafRow" style="@style/ManualTopicRow" android:text="@string/manual_scan_leaf" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="@dimen/spacing_16" android:layout_marginEnd="@dimen/spacing_16" android:background="@color/banana_divider" />
                <TextView android:id="@+id/understandRow" style="@style/ManualTopicRow" android:text="@string/manual_understand" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            </LinearLayout>
            <TextView style="@style/ManualTopicSection" android:text="@string/manual_recommendations" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/manual_card" android:clipToOutline="true">
                <TextView android:id="@+id/treatmentRow" style="@style/ManualTopicRow" android:text="@string/manual_treatment" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="@dimen/spacing_16" android:layout_marginEnd="@dimen/spacing_16" android:background="@color/banana_divider" />
                <TextView android:id="@+id/preventionRow" style="@style/ManualTopicRow" android:text="@string/manual_prevention" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            </LinearLayout>
            <TextView style="@style/ManualTopicSection" android:text="@string/manual_tips" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/manual_card" android:clipToOutline="true">
                <TextView android:id="@+id/photoRow" style="@style/ManualTopicRow" android:text="@string/manual_photo" android:drawableEnd="@drawable/ic_manual_chevron" android:drawablePadding="12dp" />
            </LinearLayout>
        </bananaq.ContentColumn>
    </ScrollView>
</LinearLayout>
