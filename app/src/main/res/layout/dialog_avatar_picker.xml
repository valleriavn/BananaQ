<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/avatar_picker_sheet_bg"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingBottom="@dimen/dialog_content_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/avatarPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/avatar_picker_heading"
            android:textColor="@color/banana_text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/closeAvatarPicker"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/closeAvatarPicker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/avatar_close_button_bg"
            android:contentDescription="@string/close_avatar_picker"
            android:padding="@dimen/spacing_12"
            android:src="@drawable/ic_avatar_close"
            app:tint="@color/banana_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/avatarPreviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">
        <ImageView
            android:id="@+id/avatarPickerPreview"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:padding="@dimen/spacing_8"
            android:scaleType="fitCenter" />
    </LinearLayout>
    <GridLayout
        android:id="@+id/avatarPickerGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:alignmentMode="alignBounds"
        android:columnCount="3"
        android:useDefaultMargins="false" />
    <bananaq.ResponsiveActionRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelAvatarSelection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:padding="@dimen/spacing_8"
            android:text="@string/cancel_scan_again"
            android:textAllCaps="false"
            android:textColor="@color/banana_green"
            app:backgroundTint="@color/banana_yellow"
            app:strokeColor="@color/banana_green"
            app:strokeWidth="0dp"
            app:cornerRadius="@dimen/pill_corner_radius" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveAvatarSelection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:padding="@dimen/spacing_8"
            android:text="@string/save_avatar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/banana_green"
            app:cornerRadius="@dimen/pill_corner_radius" />
    </bananaq.ResponsiveActionRow>
</LinearLayout>
