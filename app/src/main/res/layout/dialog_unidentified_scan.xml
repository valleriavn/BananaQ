<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/confirmation_dialog_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingBottom="@dimen/dialog_content_padding">

    <TextView
        android:layout_width="46dp"
        android:layout_height="wrap_content" android:minHeight="46dp"
        android:background="@drawable/feedback_help_circle"
        android:gravity="center"
        android:text="?"
        android:textColor="@color/banana_green"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center"
        android:text="@string/unable_identify"
        android:textColor="@color/banana_text_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:gravity="center"
        android:text="@string/unidentified_scan_prompt"
        android:textColor="@color/banana_muted"
        android:textSize="12sp" />

    <com.example.bananaq.ResponsiveActionRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelRescan"
            android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_language_yellow"
            android:backgroundTint="@color/agreement_button_default_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cancel_scan_again"
            android:textColor="@color/agreement_button_text_selector"
            android:padding="@dimen/spacing_8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnConfirmRescan"
            android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_language_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/scan_again"
            android:textColor="@color/white"
            android:padding="@dimen/spacing_8"
            android:textSize="13sp"
            android:textStyle="bold" />
</com.example.bananaq.ResponsiveActionRow>
</LinearLayout>
