<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="ManualSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
        <item name="android:layout_marginBottom">@dimen/spacing_12</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/banana_text_dark</item>
    </style>
    <style name="ManualRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginBottom">@dimen/spacing_12</item>
        <item name="android:padding">@dimen/spacing_16</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/banana_text_dark</item>
        <item name="android:background">@drawable/manual_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ManualTopicSection" parent="ManualSection">
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/banana_green</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
    </style>
    <style name="ManualTopicRow" parent="ManualRow">
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="FeedbackRatingOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">82dp</item>
        <item name="android:layout_marginStart">@dimen/spacing_4</item>
        <item name="android:layout_marginEnd">@dimen/spacing_4</item>
        <item name="android:layout_marginTop">@dimen/spacing_4</item>
        <item name="android:layout_marginBottom">@dimen/spacing_4</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/spacing_8</item>
        <item name="android:paddingEnd">@dimen/spacing_8</item>
        <item name="android:paddingTop">@dimen/spacing_8</item>
        <item name="android:paddingBottom">@dimen/spacing_8</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="FeedbackRatingIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
    </style>
    <style name="FeedbackRatingLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">@dimen/spacing_4</item>
        <item name="android:textColor">@color/banana_body</item>
        <item name="android:textSize">9sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="FeedbackSummaryRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/feedback_summary_divider</item>
    </style>
    <style name="FeedbackSummaryLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/banana_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="FeedbackSummaryValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:maxWidth">180dp</item>
        <item name="android:textColor">@color/banana_body</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DiseaseDetailSectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/account_information_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
    </style>

    <style name="DiseaseDetailSectionContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_16</item>
        <item name="android:paddingStart">@dimen/accent_content_padding</item>
    </style>

    <style name="DiseaseDetailSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/banana_body</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DiseaseDetailSectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_12</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/banana_body</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="ScannerInstructionText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
