<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ManualSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/banana_text_dark</item>
    </style>
    <style name="ManualRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/banana_text_dark</item>
        <item name="android:background">@drawable/manual_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ManualTopicSection" parent="ManualSection">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="ManualTopicRow" parent="ManualRow">
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="FeedbackRatingOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="FeedbackRatingIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
    </style>
    <style name="FeedbackRatingLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/banana_body</item>
        <item name="android:textSize">9sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="FeedbackSummaryRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/banana_body</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">@drawable/feedback_summary_divider</item>
    </style>
</resources>
