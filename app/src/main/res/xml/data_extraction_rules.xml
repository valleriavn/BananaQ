<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep scan records, images, and anonymous auth credentials on this device. -->
    <cloud-backup>
        <exclude domain="database" path="bananaq.db" />
        <exclude domain="database" path="bananaq.db-shm" />
        <exclude domain="database" path="bananaq.db-wal" />
        <exclude domain="file" path="scan_photos/" />
        <exclude domain="sharedpref" path="supabase_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bananaq.db" />
        <exclude domain="database" path="bananaq.db-shm" />
        <exclude domain="database" path="bananaq.db-wal" />
        <exclude domain="file" path="scan_photos/" />
        <exclude domain="sharedpref" path="supabase_auth.xml" />
    </device-transfer>
</data-extraction-rules>
